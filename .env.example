# ══════════════════════════════════════════════════════════════
# Memoreei Configuration
# `memoreei setup` writes these to config.env in its home directory for you.
# To edit by hand, copy there (or to .env in a dev checkout) and fill in what you need.
# Tokens and passwords (marked "secret" below) can go here too: at the next start memoreei
# moves them into its encrypted database and takes them out of this file.
# ══════════════════════════════════════════════════════════════

# ── Core ─────────────────────────────────────────────────────
# MEMOREEI_HOME=~/.local/share/memoreei   # only meaningful in a .env or the environment
# MEMOREEI_DB_PATH=~/.local/share/memoreei/memoreei.db   # default: memoreei.db in MEMOREEI_HOME
# MEMOREEI_DB_KEY=   # the database key (64 hex), for containers: set it in the environment, not here
EMBEDDING_PROVIDER=fastembed
# OPENAI_API_KEY=sk-...  # secret; only if EMBEDDING_PROVIDER=openai

# ── Auto Sync (optional) ─────────────────────────────────────
# AUTO_SYNC=false
# AUTO_SYNC_INTERVAL=300  # seconds between background syncs

# ── Network server (memoreei serve --http) ───────────────────
# API keys live hashed in the database: memoreei key create <name>
# MEMOREEI_HOST=0.0.0.0
# MEMOREEI_PORT=3679
# MEMOREEI_PUBLIC_URL=https://memories.example.com   # printed in client config
# MEMOREEI_TLS_CERT=/path/to/cert.pem
# MEMOREEI_TLS_KEY=/path/to/key.pem

# ── Discord (live API sync) ──────────────────────────────────
# DISCORD_BOT_TOKEN=   # secret
# DISCORD_CHANNEL_ID=

# ── Telegram ─────────────────────────────────────────────────
# TELEGRAM_BOT_TOKEN=   # secret
# TELEGRAM_CHAT_ID=

# ── Slack ────────────────────────────────────────────────────
# SLACK_BOT_TOKEN=   # secret
# SLACK_CHANNEL_ID=

# ── Matrix ───────────────────────────────────────────────────
# MATRIX_HOMESERVER=https://matrix.org
# MATRIX_ACCESS_TOKEN=   # secret
# MATRIX_ROOM_ID=

# ── Mastodon ─────────────────────────────────────────────────
# MASTODON_INSTANCE=https://mastodon.social
# MASTODON_HASHTAG=
# MASTODON_ACCESS_TOKEN=   # secret

# ── Gmail (IMAP) ─────────────────────────────────────────────
# GMAIL_EMAIL=
# GMAIL_APP_PASSWORD=   # secret

# ── iMessage (macOS only, local DB read) ─────────────────────
# IMESSAGE_DB_PATH=~/Library/Messages/chat.db

# ── WhatsApp (WhatsApp for Mac's database, or an iPhone backup's) ──
# WHATSAPP_DB_PATH=~/Library/Group Containers/group.net.whatsapp.WhatsApp.shared/ChatStorage.sqlite

# ── Signal Desktop (its encrypted DB, on macOS and Linux) ────
# SIGNAL_DB_KEY is written by Connect (Sources, or `memoreei setup signal`), which reads
# it from the Keychain, GNOME Keyring or KWallet once. Not typed in by hand.
# SIGNAL_DB_KEY=   # secret
# SIGNAL_DIR=  # only if Signal Desktop's data isn't in its usual place

# ── TMDB (for Movie Ring example app) ────────────────────────
# TMDB_API_KEY=
# TMDB_READ_TOKEN=
